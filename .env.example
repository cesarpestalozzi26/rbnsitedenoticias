NEXT_PUBLIC_SITE_URL=http://localhost:3000
PYTHON_BACKEND_URL=http://127.0.0.1:8000
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=RBN <noreply@rbnbrasil.com.br>
PASSWORD_RESET_SECRET=change_this_to_a_random_long_secret
# Cron protection required by the scheduled election-results collector.
# Configure the same generated secret in Vercel Production and Preview environments.
CRON_SECRET=generate_a_long_random_secret
# Election provider settings. The collector only accepts the official TSE host.
# TSE_RESULTS_BASE_URL=https://resultados.tse.jus.br
# ELECTION_POLL_INTERVAL=60
# ELECTION_DATA_STALE_AFTER_SECONDS=300
# TSE_RESULTS_PUBLIC_JWK={"kty":"OKP","crv":"Ed25519","alg":"EdDSA","kid":"...","x":"..."}
# Required by password recovery and transactional notifications.
# Keep this server-side; never expose it as NEXT_PUBLIC_*.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key

# Supabase Auth callback URLs:
# - http://localhost:3000/conta-rbn
# - https://www.rbnbrasil.com.br/conta-rbn
